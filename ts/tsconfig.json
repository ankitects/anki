{
    "extends": "$app/tsconfig",
    "include": ["lib", "routes", "src", "tests", "vite.config.ts"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "noImplicitAny": false
    }
}
