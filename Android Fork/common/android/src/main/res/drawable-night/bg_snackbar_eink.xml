<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mtrl_snackbar_background_corner_radius"/>
            <solid android:color="@color/white"/>
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/mtrl_snackbar_background_corner_radius"/>
            <solid android:color="@color/black"/>
        </shape>
    </item>
</layer-list>
